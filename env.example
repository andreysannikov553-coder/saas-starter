# Database
DATABASE_URL="postgresql://..."

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Stripe
STRIPE_SECRET_KEY="sk_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic (content engine — used as the last resort in the "fallback" chain,
# or directly when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: only needed if ANTHROPIC_API_KEY is an org-level key not scoped
# to a workspace (Anthropic then requires the anthropic-workspace-id header).
ANTHROPIC_WORKSPACE_ID="wrkspc_..."

# More free OpenAI-compatible providers for the "fallback" chain — all
# optional, each only used if its key is set. See
# src/lib/content-engine/llm/index.ts for the full chain order.
CEREBRAS_API_KEY="csk-..."
GEMINI_API_KEY="AIza..."
OPENROUTER_API_KEY="sk-or-..."
MISTRAL_API_KEY="..."

LLM_PROVIDER="fallback" # "fallback" (default, tries every configured provider above) | "claude" | "openai"

# ElevenLabs (content engine narration — required to run the TTS stage)
ELEVENLABS_API_KEY="..."

# Content engine autoposting (/api/cron/publish, see vercel.json "crons")
CRON_SECRET="..." # random string; Vercel sends it back as Authorization: Bearer <value>
TELEGRAM_PLATFORM_ACCOUNT_ID="..." # PlatformAccount id from scripts/add-telegram-account.ts

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"